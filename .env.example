# Prefer environment variables in production. Never commit real credentials.
DB_USER=seu_usuario
DB_PASSWORD=sua_senha
DB_HOST=localhost
DB_PORT=3306
DB_NAME=saboreclic
# Generate once with: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=troque-por-um-segredo-aleatorio
# Optional: comma-separated exact origins, e.g. http://localhost:5500
CORS_ORIGINS=
COOKIE_SECURE=false
